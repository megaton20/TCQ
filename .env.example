# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change_this_to_a_long_random_string
# App base URL, used for Paystack callback_url. Leave as "auto" (the
# default) and it detects itself from the incoming request - works
# automatically on localhost, through an ngrok tunnel, or on your live
# domain, with zero changes needed when switching between them.
# Set an explicit value (e.g. https://carnivalqueen.com) only if you want to
# force a fixed canonical domain regardless of request headers (some
# production setups behind certain load balancers may want this).
APP_URL=auto

# Database (Neon connection string - single string method)
# Example: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/carnival_queen?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/carnival_queen?sslmode=require
# Optional separate DB for `npm run test`
TEST_DATABASE_URL=
# Set to "false" only if connecting to a local Postgres without SSL configured
DB_SSL=true

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
# Split code applied to coin bundle purchases (developer share). Always on.
PAYSTACK_VOTE_SPLIT_CODE=SPL_xxxxxxxxxxxx
# Ticket purchase splitting is OFF by default (full ticket revenue to your
# main account). Set both of these to turn it on - leave PAYSTACK_TICKET_SPLIT_ENABLED
# as "false" (or remove it) for a normal, unsplit ticket purchase.
PAYSTACK_TICKET_SPLIT_ENABLED=false
PAYSTACK_TICKET_SPLIT_CODE=SPL_xxxxxxxxxxxx

# Cloudinary (contestant + gallery images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Coin economics: 1 coin = 1 vote. This is the naira price per coin (and per vote).
VOTE_COST_NAIRA=200

# Email (Brevo transactional email API - used for ticket delivery, email
# verification, and password reset). Get an API key from your Brevo
# dashboard under Settings -> SMTP & API -> API Keys. If this is left empty
# or Brevo's free-plan daily send limit is hit, emails just quietly fail -
# the app tells the person "email service is currently unavailable" instead
# of blocking registration, ticket purchases, or password resets.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@carnivalqueen.com
BREVO_SENDER_NAME=The Carnival Queen
