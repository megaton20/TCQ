<section class="max-w-lg mx-auto px-4 py-20 text-center">
  <h1 class="text-3xl font-extrabold text-carnival-green mb-3">Something Went Wrong</h1>
  <p class="text-gray-600 mb-4"><%= message %></p>
  <% if (detail) { %>
    <pre class="text-left text-xs bg-gray-900 text-red-300 rounded-lg p-4 overflow-x-auto mb-4"><%= detail %></pre>
  <% } %>
  <a href="/" class="inline-block bg-carnival-green text-white font-semibold px-6 py-2 rounded-full">Back Home</a>
</section>
