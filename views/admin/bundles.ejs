<section class="max-w-3xl mx-auto px-4 py-10">

   <a href="/admin" class="text-sm text-carnival-green font-semibold hover:underline">
    <i class="fa-solid fa-arrow-left mr-1"></i> Back
  </a>

  <h1 class="text-2xl font-bold text-carnival-green mb-6">vote Bundles</h1>
  <p class="text-sm text-gray-500 mb-4">1 vote = ₦200. Price is calculated automatically: votes &times; ₦200. No bonus vote.</p>
  <form action="/admin/bundles" method="POST" class="bg-white rounded-2xl shadow p-5 grid grid-cols-2 gap-3 mb-8">
    <input name="name" placeholder="Bundle Name" required class="border rounded-lg px-3 py-2 col-span-2">
    <input name="votesEquivalent" type="number" placeholder="Votes" required class="border rounded-lg px-3 py-2">
    <input name="sortOrder" type="number" placeholder="Sort Order" class="border rounded-lg px-3 py-2">
    <button class="col-span-2 bg-carnival-green text-white font-semibold py-2 rounded-full">Create Bundle</button>
  </form>
  <div class="space-y-3">
    <% bundles.forEach(b => { %>
      <div class="bg-white rounded-2xl shadow p-4 flex justify-between items-center">
        <div>
          <p class="font-bold"><%= b.name %></p>
          <p class="text-sm text-gray-500"><%= b.votesEquivalent %> votes &middot; ₦<%= Number(b.priceNaira).toLocaleString() %></p>
        </div>
        <form action="/admin/bundles/<%= b.id %>/toggle" method="POST">
          <button class="text-sm font-semibold <%= b.isActive ? 'text-red-600' : 'text-green-600' %>"><%= b.isActive ? 'Deactivate' : 'Activate' %></button>
        </form>
      </div>
    <% }) %>
  </div>
</section>
