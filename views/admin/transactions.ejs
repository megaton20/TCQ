<section class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold text-carnival-green mb-6">Transactions</h1>
  <div class="bg-white rounded-2xl shadow overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left">
        <tr><th class="p-3">User</th><th class="p-3">Type</th><th class="p-3">Amount</th><th class="p-3">Coins</th><th class="p-3">Status</th><th class="p-3">Date</th></tr>
      </thead>
      <tbody class="divide-y">
        <% transactions.forEach(t => { %>
          <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='/admin/transactions/<%= t.id %>'">
            <td class="p-3"><%= t.user.fullName %></td>
            <td class="p-3 capitalize"><%= t.type.replace('_',' ') %></td>
            <td class="p-3"><%= t.amountNaira ? '₦' + Number(t.amountNaira).toLocaleString() : '-' %></td>
            <td class="p-3"><%= t.coinAmount ? Number(t.coinAmount).toLocaleString() : '-' %></td>
            <td class="p-3 capitalize"><%= t.status %></td>
            <td class="p-3"><%= new Date(t.createdAt).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
