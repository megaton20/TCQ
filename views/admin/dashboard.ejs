<section class="max-w-5xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold text-carnival-green">Admin Dashboard</h1>
    <span class="text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full <%= isSuperAdmin ? 'bg-carnival-gold text-carnival-green' : 'bg-gray-100 text-gray-500' %>">
      <%= isSuperAdmin ? 'Super Admin' : 'Admin' %>
    </span>
  </div>

  <% if (paystackMode === null && isSuperAdmin) { %>
    <div class="bg-red-50 border border-red-200 text-red-800 text-sm rounded-2xl p-4 mb-6 flex items-start gap-2">
      <i class="fa-solid fa-circle-exclamation mt-0.5"></i>
      <span><strong>Paystack key not configured.</strong> Payments will fail until <code>PAYSTACK_SECRET_KEY</code> is set in <code>.env</code>.</span>
    </div>
  <% } %>

  <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <% if (isSuperAdmin) { %>
      <div class="bg-white rounded-2xl shadow p-5">
        <p class="text-sm text-gray-500">Total Revenue</p>
        <p class="text-2xl font-extrabold text-carnival-green">₦<%= Number(totalRevenue).toLocaleString() %></p>
      </div>
      <div class="bg-white rounded-2xl shadow p-5">
        <p class="text-sm text-gray-500">Total Users</p>
        <p class="text-2xl font-extrabold text-carnival-green"><%= Number(totalUsers).toLocaleString() %></p>
      </div>

       <a href="/admin/events" class="bg-white rounded-2xl shadow p-5 hover:shadow-lg">
      <p class="text-sm text-gray-500">All Events</p>
      <p class="text-2xl font-extrabold text-carnival-green"><%= totalEvents %></p>
    </a>
    <% } else { %>
      <div class="bg-white rounded-2xl shadow p-5">
        <p class="text-sm text-gray-500">Valid Tickets</p>
        <p class="text-2xl font-extrabold text-carnival-green"><%= ticketsSold %></p>
      </div>
    <% } %>

    <a href="/admin/applications" class="bg-white rounded-2xl shadow p-5 hover:shadow-lg">
      <p class="text-sm text-gray-500">Pending Applications</p>
      <p class="text-2xl font-extrabold text-carnival-green"><%= pendingApplications %></p>
    </a>
    <div class="bg-white rounded-2xl shadow p-5">
      <p class="text-sm text-gray-500">Approved Contestants</p>
      <p class="text-2xl font-extrabold text-carnival-green"><%= contestantCount %></p>
    </div>
    <a href="/admin/door-entries" class="bg-white rounded-2xl shadow p-5 hover:shadow-lg">
      <p class="text-sm text-gray-500">Door Entries Recorded</p>
      <p class="text-2xl font-extrabold text-carnival-green"><%= doorEntriesCount %></p>
    </a>

  </div>

  <div class="flex flex-wrap gap-3 text-sm font-semibold mb-8">
    <a href="/admin/applications" class="bg-carnival-green text-white px-4 py-2 rounded-full">Applications</a>
    <a href="/admin/contestants" class="bg-carnival-green text-white px-4 py-2 rounded-full">Contestants</a>
    <a href="/admin/editions" class="bg-carnival-green text-white px-4 py-2 rounded-full">Editions</a>
    <a href="/admin/bundles" class="bg-carnival-green text-white px-4 py-2 rounded-full">Vote Bundles</a>
    <a href="/admin/events" class="bg-carnival-green text-white px-4 py-2 rounded-full">Events</a>
    <a href="/admin/tables" class="bg-carnival-green text-white px-4 py-2 rounded-full">Table Management</a>
    <a href="/admin/door-entries" class="bg-carnival-green text-white px-4 py-2 rounded-full">Door Entry Records</a>
    <a href="/admin/staff" class="bg-carnival-green text-white px-4 py-2 rounded-full">Staff</a>
    <% if (isSuperAdmin) { %>
      <a href="/admin/tickets" class="bg-carnival-gold text-carnival-green px-4 py-2 rounded-full">Tickets</a>
      <a href="/admin/transactions" class="bg-carnival-gold text-carnival-green px-4 py-2 rounded-full">Transactions</a>
    <% } %>
  </div>

  <div class="grid <%= isSuperAdmin ? 'md:grid-cols-2' : '' %> gap-6">
    <div>
      <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-3">Live Activity</h2>
      <div id="admin-feed" class="bg-white rounded-2xl shadow divide-y max-h-96 overflow-y-auto">
        <p class="p-4 text-sm text-gray-400" id="admin-feed-empty">Waiting for activity...</p>
      </div>
    </div>

    <% if (isSuperAdmin) { %>
      <div>
        <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-3">Live Revenue</h2>
        <div id="revenue-feed" class="bg-white rounded-2xl shadow divide-y max-h-96 overflow-y-auto">
          <p class="p-4 text-sm text-gray-400" id="revenue-feed-empty">Waiting for purchases...</p>
        </div>
      </div>
    <% } %>
  </div>
</section>

<script>
  const socket = window.appSocket;
  socket.emit('join:admin-feed');
  <% if (isSuperAdmin) { %>
  socket.emit('join:admin-feed-revenue');
  <% } %>

  function prependFeedItem(containerId, emptyId, html) {
    const container = document.getElementById(containerId);
    const empty = document.getElementById(emptyId);
    if (empty) empty.remove();
    const item = document.createElement('div');
    item.className = 'p-3 text-sm';
    item.innerHTML = html;
    container.prepend(item);
    // Keep the feed from growing forever
    while (container.children.length > 30) container.removeChild(container.lastChild);
  }

  const feedIcons = {
    vote: 'fa-check-to-slot text-carnival-gold',
    ticket_checkin: 'fa-ticket text-green-600',
    table_guest_checkin: 'fa-users text-green-600',
    walkin_guest_checkin: 'fa-user-plus text-yellow-600',
    new_application: 'fa-file-lines text-carnival-green'
  };

  socket.on('admin:feed', (data) => {
    const icon = feedIcons[data.type] || 'fa-circle-info text-gray-400';
    const time = new Date(data.timestamp).toLocaleTimeString();
    prependFeedItem('admin-feed', 'admin-feed-empty',
      `<i class="fa-solid ${icon} mr-2"></i>${data.message} <span class="text-gray-400 text-xs">(${time})</span>`);
  });

  socket.on('admin:revenue_feed', (data) => {
    const time = new Date(data.timestamp).toLocaleTimeString();
    const amount = data.amountNaira ? `₦${Number(data.amountNaira).toLocaleString()}` : '';
    prependFeedItem('revenue-feed', 'revenue-feed-empty',
      `<i class="fa-solid fa-coins text-carnival-gold mr-2"></i>${data.message}
       <span class="font-bold text-carnival-green">${amount}</span>
       <span class="text-gray-400 text-xs">(${time})</span>`);
  });
</script>
