<section class="max-w-3xl mx-auto px-4 py-10">

   <a href="/admin" class="text-sm text-carnival-green font-semibold hover:underline">
    <i class="fa-solid fa-arrow-left mr-1"></i> Back
  </a>

  <h1 class="text-2xl font-bold text-carnival-green mb-6">Editions / Seasons</h1>
  <form action="/admin/editions" method="POST" class="bg-white rounded-2xl shadow p-5 grid grid-cols-2 gap-3 mb-8">
    <p class="col-span-2 font-semibold text-sm text-gray-500">Create Edition</p>
    <input name="year" type="number" placeholder="Year" required class="border rounded-lg px-3 py-2">
    <input name="title" placeholder="Title" required class="border rounded-lg px-3 py-2">
    <input name="theme" placeholder="Theme (e.g. Rhythm of the Coast)" class="border rounded-lg px-3 py-2 col-span-2">
    <label class="text-xs text-gray-500 col-span-2 -mb-2">Voting Opens</label>
    <input name="votingOpensAt" type="datetime-local" class="border rounded-lg px-3 py-2">
    <label class="text-xs text-gray-500 -mb-2">Voting Closes</label>
    <input name="votingClosesAt" type="datetime-local" class="border rounded-lg px-3 py-2">
    <label class="text-xs text-gray-500 col-span-2 -mb-2">Main Event Date</label>
    <input name="eventDate" type="datetime-local" class="border rounded-lg px-3 py-2 col-span-2">
    <textarea name="description" placeholder="Description" class="border rounded-lg px-3 py-2 col-span-2"></textarea>
    <button class="col-span-2 bg-carnival-green text-white font-semibold py-2 rounded-full">Create Edition</button>
  </form>

  <div class="space-y-4">
    <% editions.forEach(e => { %>
      <div class="bg-white rounded-2xl shadow p-5">
        <div class="flex justify-between items-center mb-4">
          <p class="font-bold"><%= e.title %> (<%= e.year %>) <% if (e.isCurrent) { %><span class="text-xs bg-carnival-gold text-carnival-green px-2 py-0.5 rounded-full ml-2">Current</span><% } %></p>
          <% if (!e.isCurrent) { %>
            <form action="/admin/editions/<%= e.id %>/set-current" method="POST">
              <button class="text-sm font-semibold text-carnival-green underline">Make Current</button>
            </form>
          <% } %>
        </div>

        <form action="/admin/editions/<%= e.id %>/theme" method="POST" enctype="multipart/form-data" class="border-t pt-4 space-y-2">
          <p class="text-xs font-bold text-gray-400 uppercase tracking-wide">Home Page Theme Section</p>
          <input name="theme" value="<%= e.theme || '' %>" placeholder="Theme title" class="w-full border rounded-lg px-3 py-2 text-sm">
          <textarea name="themeDescription" placeholder="Theme description shown on the home page" rows="3"
                    class="w-full border rounded-lg px-3 py-2 text-sm"><%= e.themeDescription || '' %></textarea>
          <div class="flex items-center gap-3">
            <% if (e.themeImageUrl) { %>
              <img src="<%= e.themeImageUrl %>" class="w-16 h-16 rounded-lg object-cover">
            <% } %>
            <input type="file" name="themeImage" accept="image/*" class="text-sm flex-1">
          </div>
          <button class="bg-carnival-gold text-carnival-green font-semibold text-sm px-4 py-2 rounded-full">Save Theme</button>
        </form>
      </div>
    <% }) %>
  </div>
</section>
