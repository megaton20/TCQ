<section class="max-w-4xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-carnival-green">Events & Tickets</h1>
    <div class="flex gap-4 text-sm font-semibold">
      <% if (isSuperAdmin) { %>
        <a href="/admin/tickets" class="text-carnival-green hover:underline"><i class="fa-solid fa-ticket mr-1"></i> Manage Tickets</a>
      <% } %>
      <a href="/admin/tables" class="text-carnival-green hover:underline"><i class="fa-solid fa-users mr-1"></i> Table Management</a>
    </div>
  </div>

  <form action="/admin/events" method="POST" class="bg-white rounded-2xl shadow p-5 grid grid-cols-2 gap-3 mb-8">
    <p class="col-span-2 font-semibold text-sm text-gray-500">Create Event</p>
    <input name="name" placeholder="Event Name" required class="border rounded-lg px-3 py-2 col-span-2">
    <input name="venue" placeholder="Venue" required class="border rounded-lg px-3 py-2 col-span-2">
    <input name="eventDate" type="datetime-local" required class="border rounded-lg px-3 py-2">
    <input name="capacity" type="number" placeholder="Capacity (optional)" class="border rounded-lg px-3 py-2">
    <textarea name="description" placeholder="Description" class="border rounded-lg px-3 py-2 col-span-2"></textarea>
    <button class="col-span-2 bg-carnival-green text-white font-semibold py-2 rounded-full">Create Event</button>
  </form>

  <div class="space-y-6">
    <% events.forEach(e => { %>
      <div class="bg-white rounded-2xl shadow p-5">
        <div class="flex items-start justify-between mb-1">
          <p class="font-bold text-lg"><%= e.name %> <% if (!e.isActive) { %><span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full ml-1">Inactive</span><% } %></p>
          <% if (isSuperAdmin) { %>
            <button type="button" onclick="document.getElementById('edit-event-<%= e.id %>').classList.toggle('hidden')"
                    class="text-xs font-semibold text-carnival-green hover:underline">Edit Event</button>
          <% } %>
        </div>
        <p class="text-sm text-gray-500 mb-3"><%= e.venue %> &middot; <%= new Date(e.eventDate).toLocaleString() %> &middot; <%= e.ticketsSold %> sold<% if (e.capacity) { %> / <%= e.capacity %><% } %></p>

        <% if (isSuperAdmin) { %>
          <div id="edit-event-<%= e.id %>" class="hidden bg-gray-50 rounded-xl p-4 mb-4 space-y-3">
            <form action="/admin/events/<%= e.id %>" method="POST" class="grid grid-cols-2 gap-2 text-sm">
              <input name="name" value="<%= e.name %>" placeholder="Event Name" required class="border rounded-lg px-2 py-1.5 col-span-2">
              <input name="venue" value="<%= e.venue %>" placeholder="Venue" required class="border rounded-lg px-2 py-1.5 col-span-2">
              <input name="eventDate" type="datetime-local" value="<%= new Date(e.eventDate).toISOString().slice(0,16) %>" required class="border rounded-lg px-2 py-1.5">
              <input name="capacity" type="number" value="<%= e.capacity || '' %>" placeholder="Capacity" class="border rounded-lg px-2 py-1.5">
              <textarea name="description" placeholder="Description" class="border rounded-lg px-2 py-1.5 col-span-2"><%= e.description || '' %></textarea>
              <label class="col-span-2 flex items-center gap-2 text-sm">
                <input type="checkbox" name="isActive" <%= e.isActive ? 'checked' : '' %>> On sale / active
              </label>
              <button class="col-span-2 bg-carnival-green text-white font-semibold py-1.5 rounded-full">Save Event</button>
            </form>
            <form action="/admin/events/<%= e.id %>/delete" method="POST"
                  onsubmit="return confirm('Delete this event permanently? This also deletes its ticket tiers and every ticket sold against it. This cannot be undone.');">
              <button class="w-full bg-white border border-red-200 text-red-600 font-semibold py-1.5 rounded-full text-sm hover:bg-red-50">
                <i class="fa-solid fa-trash mr-1"></i> Delete Event
              </button>
            </form>
          </div>
        <% } %>

        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-2">Ticket Tiers</p>
        <div class="space-y-2 mb-4">
          <% e.tiers.forEach(tier => { %>
            <div class="bg-gray-50 rounded-xl p-3 text-sm">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-semibold">
                    <%= tier.name %>
                    <% if (tier.tierType === 'table') { %><span class="text-xs bg-carnival-gold text-carnival-green px-2 py-0.5 rounded-full ml-1"><%= tier.seatsIncluded %> seats</span><% } %>
                  </p>
                  <p class="text-gray-500">₦<%= Number(tier.priceNaira).toLocaleString() %> &middot; <%= tier.quantitySold %> sold<% if (tier.quantityAvailable) { %> / <%= tier.quantityAvailable %><% } %></p>
                </div>
                <div class="flex items-center gap-3 text-xs font-semibold">
                  <form action="/admin/tiers/<%= tier.id %>/toggle" method="POST">
                    <button class="<%= tier.isActive ? 'text-red-600' : 'text-green-600' %>"><%= tier.isActive ? 'Deactivate' : 'Activate' %></button>
                  </form>
                  <% if (isSuperAdmin) { %>
                    <button type="button" onclick="document.getElementById('edit-tier-<%= tier.id %>').classList.toggle('hidden')"
                            class="text-carnival-green hover:underline">Edit</button>
                    <form action="/admin/tiers/<%= tier.id %>/delete" method="POST"
                          onsubmit="return confirm('Delete this tier? Tickets already sold keep their data but lose the tier link. This cannot be undone.');">
                      <button class="text-red-500">Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
              <% if (isSuperAdmin) { %>
                <form action="/admin/tiers/<%= tier.id %>" method="POST" id="edit-tier-<%= tier.id %>" class="hidden grid grid-cols-2 gap-2 mt-3 pt-3 border-t">
                  <input name="name" value="<%= tier.name %>" required class="border rounded-lg px-2 py-1.5 col-span-2">
                  <select name="tierType" class="border rounded-lg px-2 py-1.5">
                    <option value="single" <%= tier.tierType === 'single' ? 'selected' : '' %>>Single seat</option>
                    <option value="table" <%= tier.tierType === 'table' ? 'selected' : '' %>>Table (group)</option>
                  </select>
                  <input name="seatsIncluded" type="number" value="<%= tier.seatsIncluded %>" placeholder="Seats" class="border rounded-lg px-2 py-1.5">
                  <input name="priceNaira" type="number" value="<%= tier.priceNaira %>" required class="border rounded-lg px-2 py-1.5">
                  <input name="quantityAvailable" type="number" value="<%= tier.quantityAvailable || '' %>" placeholder="Max available" class="border rounded-lg px-2 py-1.5">
                  <button class="col-span-2 bg-carnival-gold text-carnival-green font-semibold py-1.5 rounded-full">Save Tier</button>
                </form>
              <% } %>
            </div>
          <% }) %>
          <% if (!e.tiers.length) { %><p class="text-xs text-gray-400">No tiers yet - add Regular, VIP, or Table tiers below.</p><% } %>
        </div>

        <form action="/admin/events/<%= e.id %>/tiers" method="POST" class="grid grid-cols-2 gap-2 text-sm border-t pt-3">
          <input name="name" placeholder="Tier name (e.g. VIP)" required class="border rounded-lg px-2 py-1.5 col-span-2">
          <select name="tierType" class="border rounded-lg px-2 py-1.5">
            <option value="single">Single seat (Regular/VIP)</option>
            <option value="table">Table (group)</option>
          </select>
          <input name="seatsIncluded" type="number" placeholder="Seats (if table)" class="border rounded-lg px-2 py-1.5">
          <input name="priceNaira" type="number" placeholder="Price (₦)" required class="border rounded-lg px-2 py-1.5">
          <input name="quantityAvailable" type="number" placeholder="Max available (optional)" class="border rounded-lg px-2 py-1.5">
          <button class="col-span-2 bg-carnival-gold text-carnival-green font-semibold py-1.5 rounded-full">Add Tier</button>
        </form>
      </div>
    <% }) %>
  </div>
</section>
