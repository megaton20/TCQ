<section class="max-w-3xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-bold text-carnival-green mb-1">Live Leaderboard</h1>
  <p class="text-gray-500 mb-6"><%= currentEdition ? currentEdition.title : '' %> &middot; updates in real time</p>

  <ol id="leaderboard-list" class="space-y-3">
    <% contestants.forEach((c, i) => { %>
      <li class="flex items-center gap-4 bg-white rounded-2xl shadow p-4" data-id="<%= c.id %>">
        <span class="text-xl font-bold text-carnival-gold w-6"><%= i + 1 %></span>
        <img src="<%= (c.images.find(im => im.isThumbnail) || c.images[0] || {}).url || '/public/img/placeholder.jpg' %>"
             class="w-12 h-12 rounded-full object-cover">
        <div class="flex-1">
          <a href="/contestants/<%= c.slug %>" class="font-semibold text-carnival-green hover:underline"><%= c.fullName %></a>
        </div>
        <span class="font-bold text-lg vote-value"><%= Number(c.voteCount).toLocaleString() %></span>
      </li>
    <% }) %>
  </ol>
</section>

<script>
  const editionId = "<%= currentEdition ? currentEdition.id : '' %>";
  const socket = window.appSocket;
  if (editionId) socket.emit('join:leaderboard', editionId);

  socket.on('leaderboard:update', (data) => {
    if (data.editionId !== editionId) return;
    const list = document.getElementById('leaderboard-list');
    list.innerHTML = data.contestants.map((c, i) => `
      <li class="flex items-center gap-4 bg-white rounded-2xl shadow p-4" data-id="${c.id}">
        <span class="text-xl font-bold text-carnival-gold w-6">${i + 1}</span>
        <div class="flex-1">
          <a href="/contestants/${c.slug}" class="font-semibold text-carnival-green hover:underline">${c.fullName}</a>
        </div>
        <span class="font-bold text-lg vote-value">${Number(c.voteCount).toLocaleString()}</span>
      </li>
    `).join('');
  });
</script>
