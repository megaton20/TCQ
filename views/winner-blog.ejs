<section class="max-w-4xl mx-auto px-4 py-10">
  <a href="/contestants/<%= contestant.slug %>" class="text-sm text-carnival-green font-semibold hover:underline">
    <i class="fa-solid fa-arrow-left mr-1"></i> Back to <%= contestant.fullName %>'s profile
  </a>

  <div class="mt-4 mb-8 text-center">
    <p class="uppercase tracking-widest text-carnival-gold text-sm mb-1">
      <i class="fa-solid fa-crown"></i> <%= contestant.winnerPosition || 'Queen' %>, <%= contestant.edition.title %>
    </p>
    <h1 class="text-3xl md:text-4xl font-bold text-carnival-green"><%= contestant.fullName %>'s Charity Outreach</h1>
  </div>

  <% if (contestant.blogContent) { %>
    <div class="prose max-w-none text-gray-700 mb-10 whitespace-pre-line">
      <%= contestant.blogContent %>
    </div>
  <% } else { %>
    <p class="text-gray-500 text-center mb-10">Updates on this queen's community outreach are coming soon.</p>
  <% } %>

  <% if (contestant.images && contestant.images.length) { %>
    <h2 class="text-xl font-bold text-carnival-green mb-4">
      <i class="fa-solid fa-images mr-1"></i> Outreach Gallery
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      <% contestant.images.forEach(img => { %>
        <a href="<%= img.url %>" target="_blank" class="block aspect-square overflow-hidden rounded-xl bg-gray-200 group">
          <img src="<%= img.url %>" alt="<%= img.caption || 'Outreach photo' %>"
               class="w-full h-full object-cover group-hover:scale-105 transition">
        </a>
      <% }) %>
    </div>
  <% } %>
</section>
