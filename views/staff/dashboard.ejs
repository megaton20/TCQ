<section class="max-w-md mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-carnival-green">My Dashboard</h1>
    <a href="/staff/checkin" class="text-xs font-semibold text-carnival-green hover:underline">
      <i class="fa-solid fa-qrcode mr-1"></i>Back to Scanner
    </a>
  </div>

  <div class="grid grid-cols-2 gap-4 mb-8">
    <div class="bg-white rounded-2xl shadow p-5 text-center">
      <p class="text-sm text-gray-500 mb-1">Checked In Today</p>
      <p class="text-3xl font-extrabold text-carnival-green"><%= scannedToday %></p>
    </div>
    <div class="bg-white rounded-2xl shadow p-5 text-center">
      <p class="text-sm text-gray-500 mb-1">All-Time Total</p>
      <p class="text-3xl font-extrabold text-carnival-green"><%= scannedAllTime %></p>
    </div>
  </div>

  <div class="flex items-center justify-between mb-3">
    <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wide">Recent Scans</h2>
    <a href="/staff/history" class="text-xs font-semibold text-carnival-green hover:underline">View all &rarr;</a>
  </div>
  <div class="bg-white rounded-2xl shadow divide-y">
    <% recentScans.forEach(e => { %>
      <div class="p-4">
        <div class="flex items-center justify-between mb-1">
          <p class="font-semibold text-sm"><%= e.guestName %></p>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full
            <%= e.method === 'walk-in' ? 'bg-yellow-100 text-yellow-700'
                : (e.method === 'table-roster' ? 'bg-carnival-gold/20 text-carnival-green' : 'bg-green-100 text-green-700') %>">
            <%= e.method.replace('_', ' ') %>
          </span>
        </div>
        <p class="text-xs text-gray-400"><%= e.eventName %> &middot; <%= e.tierName %> &middot; <%= new Date(e.checkedInAt).toLocaleString() %></p>
      </div>
    <% }) %>
    <% if (!recentScans.length) { %>
      <p class="p-4 text-sm text-gray-400 text-center">No scans yet - get started at the scanner.</p>
    <% } %>
  </div>
</section>
