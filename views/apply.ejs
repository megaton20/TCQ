<section class="max-w-2xl mx-auto px-4 py-12">
  <h1 class="text-3xl font-bold text-carnival-green mb-2">Become a Contestant</h1>
  <p class="text-gray-500 mb-6">
    <%= currentEdition ? currentEdition.title : 'Registration is currently closed.' %>
  </p>

  <div class="bg-carnival-gold/10 rounded-2xl p-6 mb-8">
    <h2 class="font-bold text-carnival-green mb-3">Requirements</h2>
    <ul class="list-disc list-inside space-y-1 text-gray-700 text-sm">
      <li>Must be female, aged 18&ndash;28 (applicants under 18 need guardian consent)</li>
      <li>Must be a Nigerian citizen or resident</li>
      <li>Valid government-issued ID (National ID, Voter's Card, or Passport)</li>
      <li>One clear passport photograph</li>
      <li>One full-length photograph</li>
      <li>Must be available for rehearsals and the final event date</li>
      <li>Must not be married or pregnant at the time of the event</li>
    </ul>
  </div>

  <% if (existing) { %>
    <div class="bg-white rounded-2xl shadow p-6 text-center">
      <p class="font-semibold text-carnival-green mb-1">You've already applied for this edition.</p>
      <p class="text-sm text-gray-500">Status: <span class="capitalize font-semibold"><%= existing.status %></span></p>
    </div>
  <% } else if (!currentEdition) { %>
    <p class="text-center text-gray-500">Please check back when registration opens.</p>
  <% } else { %>
    <form action="/apply" method="POST" enctype="multipart/form-data" class="bg-white rounded-2xl shadow p-6 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2">
          <label class="block text-sm font-medium mb-1">Full Name</label>
          <input name="fullName" required class="w-full border rounded-lg px-3 py-2">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Date of Birth</label>
          <input type="date" name="dateOfBirth" required class="w-full border rounded-lg px-3 py-2">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Gender</label>
          <select name="gender" required class="w-full border rounded-lg px-3 py-2">
            <option value="Female">Female</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">State of Origin</label>
          <input name="stateOfOrigin" required class="w-full border rounded-lg px-3 py-2">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Phone</label>
          <input name="phone" required class="w-full border rounded-lg px-3 py-2">
        </div>
        <div class="col-span-2">
          <label class="block text-sm font-medium mb-1">Home Address</label>
          <input name="address" required class="w-full border rounded-lg px-3 py-2">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Occupation</label>
          <input name="occupation" class="w-full border rounded-lg px-3 py-2">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Height</label>
          <input name="height" placeholder="e.g. 5'7&quot;" class="w-full border rounded-lg px-3 py-2">
        </div>
        <div class="col-span-2">
          <label class="block text-sm font-medium mb-1">Instagram Handle</label>
          <input name="instagramHandle" class="w-full border rounded-lg px-3 py-2">
        </div>
        <div class="col-span-2">
          <label class="block text-sm font-medium mb-1">Why do you want to join?</label>
          <textarea name="whyJoin" rows="3" class="w-full border rounded-lg px-3 py-2"></textarea>
        </div>
      </div>

      <hr class="my-2">
      <h3 class="font-semibold text-carnival-green">Upload Documents</h3>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1">Passport Photo</label>
          <input type="file" name="passportPhoto" accept="image/*" required class="w-full text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Full-Length Photo</label>
          <input type="file" name="fullLengthPhoto" accept="image/*" required class="w-full text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Valid ID</label>
          <input type="file" name="idDocument" accept="image/*,.pdf" required class="w-full text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Guardian Consent (if under 18)</label>
          <input type="file" name="guardianConsent" accept="image/*,.pdf" class="w-full text-sm">
        </div>
      </div>

      <button class="w-full bg-carnival-green text-white font-semibold py-3 rounded-full hover:opacity-90 mt-4">
        Submit Application
      </button>
    </form>
  <% } %>
</section>
