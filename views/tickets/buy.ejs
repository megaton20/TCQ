<%
  const d = new Date(event.eventDate);
  const dateStr = d.toLocaleDateString('en-GB');
  const timeStr = d.toLocaleTimeString('en-GB', { hour12: false });
%>
<section class="max-w-sm mx-auto px-4 py-10">

  <div class="rounded-3xl shadow-2xl overflow-hidden bg-white mb-6">
    <div class="relative text-white text-center px-6 pt-7 pb-8"
         style="background: linear-gradient(135deg, #0B5D33 0%, #073D21 100%);">
      <div class="absolute inset-0 opacity-10"
           style="background-image: repeating-linear-gradient(45deg, #fff 0, #fff 1px, transparent 1px, transparent 12px);"></div>
      <div class="relative">
        <i class="fa-solid fa-crown text-carnival-gold text-2xl mb-2"></i>
        <p class="uppercase tracking-[0.25em] text-xs text-carnival-gold font-semibold mb-2"><%= tier.name %></p>
        <h1 class="text-xl font-extrabold leading-snug"><%= event.name %></h1>
      </div>
    </div>

    <div class="bg-white px-6 py-5 space-y-3 text-sm text-gray-700">
      <div class="flex items-center gap-3">
        <i class="fa-solid fa-location-dot text-carnival-green w-4 text-center"></i>
        <span><%= event.venue %></span>
      </div>
      <div class="flex items-center gap-3">
        <i class="fa-solid fa-calendar-days text-carnival-green w-4 text-center"></i>
        <span><%= dateStr %>, <%= timeStr %></span>
      </div>
      <% if (tier.tierType === 'table') { %>
        <div class="flex items-center gap-3">
          <i class="fa-solid fa-users text-carnival-green w-4 text-center"></i>
          <span>Seats <%= tier.seatsIncluded %> people</span>
        </div>
      <% } %>
      <div class="flex items-center gap-3">
        <i class="fa-solid fa-tag text-carnival-green w-4 text-center"></i>
        <span class="font-bold text-carnival-green">₦<%= Number(tier.priceNaira).toLocaleString() %></span>
      </div>
    </div>
  </div>

  <% if (tier.tierType === 'table') { %>
    <div class="bg-carnival-gold/10 text-sm text-gray-700 rounded-2xl p-4 mb-4">
      <i class="fa-solid fa-circle-info text-carnival-green mr-1"></i>
      You'll be registered as the table owner. After payment, add your <%= tier.seatsIncluded - 1 %> guests by name from "Manage Table" - staff will check each guest in individually against that list at the door.
    </div>
  <% } %>

  <form action="/tickets/tier/<%= tier.id %>/buy" method="POST" class="bg-white rounded-2xl shadow p-6 space-y-4">
    <div>
      <label class="block text-sm font-medium mb-1"><%= tier.tierType === 'table' ? "Table Owner's Name" : "Ticket Holder's Name" %></label>
      <input name="holderName" value="<%= currentUser.fullName %>" required class="w-full border rounded-lg px-3 py-2">
      <p class="text-xs text-gray-400 mt-1">This name will be printed on the ticket.</p>
    </div>
    <button class="w-full bg-carnival-green text-white font-semibold py-3 rounded-full hover:opacity-90">
      Proceed to Payment &middot; ₦<%= Number(tier.priceNaira).toLocaleString() %>
    </button>
  </form>
</section>
