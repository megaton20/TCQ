<%- include('_nav', { active: 'overview' }) %>

<section class="max-w-4xl mx-auto px-4 py-6">
  <p class="text-sm text-gray-500 mb-1">Welcome back,</p>
  <h1 class="text-xl font-bold text-carnival-green mb-5"><%= currentUser.fullName %></h1>

  <!-- Fancy "bank card" style balance display -->
  <div class="relative rounded-3xl p-6 mb-6 text-white overflow-hidden shadow-lg"
       style="background: linear-gradient(135deg, #0B5D33 0%, #073D21 100%);">
    <div class="absolute -right-8 -top-8 w-40 h-40 rounded-full bg-carnival-gold/10"></div>
    <div class="absolute -right-2 top-16 w-24 h-24 rounded-full bg-white/5"></div>

    <div class="relative flex items-center justify-between mb-8">
      <span class="text-xs uppercase tracking-widest text-white/70">Voting Wallet</span>
      <i class="fa-solid fa-crown text-carnival-gold text-xl"></i>
    </div>

    <div class="relative mb-6">
      <p class="text-xs text-white/60 mb-1">Available Balance</p>
      <p class="text-4xl font-extrabold tracking-tight flex items-center gap-2">
        <i class="fa-solid fa-coins text-carnival-gold text-2xl"></i>
        <%= Number(currentUser.wallet.coinBalance).toLocaleString() %>
        <span class="text-base font-medium text-white/60">coins</span>
      </p>
      <p class="text-xs text-white/50 mt-1">= <%= Number(currentUser.wallet.coinBalance).toLocaleString() %> votes</p>
    </div>

    <div class="relative flex items-center justify-between text-xs text-white/70 font-mono tracking-widest">
      <span>&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; <%= currentUser.id.slice(0, 4).toUpperCase() %></span>
      <span>THE CARNIVAL QUEEN</span>
    </div>
  </div>

  <!-- Quick actions, banking-app style icon row -->
  <div class="grid grid-cols-4 gap-3 mb-8">
    <a href="/wallet/buy" class="flex flex-col items-center gap-2 group">
      <span class="w-14 h-14 flex items-center justify-center rounded-2xl bg-carnival-green text-white text-xl group-hover:opacity-90">
        <i class="fa-solid fa-plus"></i>
      </span>
      <span class="text-xs font-semibold text-gray-600">Top Up</span>
    </a>
    <a href="/contestants" class="flex flex-col items-center gap-2 group">
      <span class="w-14 h-14 flex items-center justify-center rounded-2xl bg-carnival-gold text-carnival-green text-xl group-hover:opacity-90">
        <i class="fa-solid fa-check-to-slot"></i>
      </span>
      <span class="text-xs font-semibold text-gray-600">Vote</span>
    </a>
    <a href="/dashboard/tickets" class="flex flex-col items-center gap-2 group">
      <span class="w-14 h-14 flex items-center justify-center rounded-2xl bg-gray-100 text-carnival-green text-xl group-hover:bg-gray-200">
        <i class="fa-solid fa-ticket"></i>
      </span>
      <span class="text-xs font-semibold text-gray-600">Tickets</span>
    </a>
    <a href="/dashboard/wallet" class="flex flex-col items-center gap-2 group">
      <span class="w-14 h-14 flex items-center justify-center rounded-2xl bg-gray-100 text-carnival-green text-xl group-hover:bg-gray-200">
        <i class="fa-solid fa-receipt"></i>
      </span>
      <span class="text-xs font-semibold text-gray-600">History</span>
    </a>
  </div>

  <!-- Recent activity feed, banking-app transaction list style -->
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wide">Recent Votes</h2>
    <a href="/dashboard/votes" class="text-xs font-semibold text-carnival-green hover:underline">See all</a>
  </div>
  <div class="bg-white rounded-2xl shadow divide-y mb-8">
    <% recentVotes.forEach(v => { %>
      <div class="p-4 flex items-center gap-3">
        <span class="w-10 h-10 rounded-full bg-carnival-gold/15 text-carnival-green flex items-center justify-center">
          <i class="fa-solid fa-check-to-slot"></i>
        </span>
        <div class="flex-1 min-w-0">
          <p class="font-semibold truncate"><%= v.contestant.fullName %></p>
          <p class="text-xs text-gray-400"><%= new Date(v.createdAt).toLocaleDateString() %></p>
        </div>
        <p class="font-bold text-red-500 text-sm">&minus;<%= v.voteCount %></p>
      </div>
    <% }) %>
    <% if (!recentVotes.length) { %><p class="p-4 text-sm text-gray-500">No votes yet.</p><% } %>
  </div>

  <div class="flex items-center justify-between mb-3">
    <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wide">My Tickets</h2>
    <a href="/dashboard/tickets" class="text-xs font-semibold text-carnival-green hover:underline">See all</a>
  </div>
  <div class="bg-white rounded-2xl shadow divide-y">
    <% recentTickets.forEach(t => { %>
      <a href="/tickets/my/<%= t.id %>" class="p-4 flex items-center gap-3 hover:bg-gray-50">
        <span class="w-10 h-10 rounded-full bg-carnival-green/10 text-carnival-green flex items-center justify-center">
          <i class="fa-solid fa-ticket"></i>
        </span>
        <div class="flex-1 min-w-0">
          <p class="font-semibold truncate"><%= t.event.name %></p>
          <p class="text-xs text-gray-400"><%= new Date(t.event.eventDate).toLocaleDateString() %></p>
        </div>
        <span class="text-xs font-semibold capitalize <%= t.status === 'valid' ? 'text-green-600' : (t.status === 'used' ? 'text-gray-400' : 'text-yellow-600') %>"><%= t.status.replace('_',' ') %></span>
      </a>
    <% }) %>
    <% if (!recentTickets.length) { %><p class="p-4 text-sm text-gray-500">No tickets yet.</p><% } %>
  </div>
</section>
