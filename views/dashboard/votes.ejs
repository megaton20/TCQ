<%- include('_nav', { active: 'votes' }) %>

<section class="max-w-4xl mx-auto px-4 py-6">
  <h1 class="text-lg font-bold text-carnival-green mb-4">Voting History</h1>
  <div class="bg-white rounded-2xl shadow divide-y">
    <% votes.forEach(v => { %>
      <div class="p-4 flex items-center gap-3">
        <span class="w-10 h-10 rounded-full bg-carnival-gold/15 text-carnival-green flex items-center justify-center">
          <i class="fa-solid fa-check-to-slot"></i>
        </span>
        <div class="flex-1 min-w-0">
          <a href="/contestants/<%= v.contestant.slug %>" class="font-semibold hover:underline truncate block"><%= v.contestant.fullName %></a>
          <p class="text-xs text-gray-400"><%= new Date(v.createdAt).toLocaleDateString() %></p>
        </div>
        <div class="text-right">
          <p class="font-bold text-red-500 text-sm">&minus;<%= v.voteCount %> votes</p>
          <p class="text-xs text-gray-400"><%= Number(v.coinsSpent).toLocaleString() %> coins</p>
        </div>
      </div>
    <% }) %>
    <% if (!votes.length) { %><p class="p-4 text-sm text-gray-500">No votes yet.</p><% } %>
  </div>
</section>
