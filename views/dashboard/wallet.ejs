<%- include('_nav', { active: 'wallet' }) %>

<section class="max-w-4xl mx-auto px-4 py-6">
  <div class="relative rounded-3xl p-6 mb-6 text-white overflow-hidden shadow-lg"
       style="background: linear-gradient(135deg, #0B5D33 0%, #073D21 100%);">
    <div class="absolute -right-8 -top-8 w-40 h-40 rounded-full bg-carnival-gold/10"></div>
    <p class="text-xs uppercase tracking-widest text-white/70 mb-6">Voting Wallet</p>
    <p class="text-4xl font-extrabold flex items-center gap-2 mb-1">
      <i class="fa-solid fa-coins text-carnival-gold text-2xl"></i>
      <%= Number(wallet.coinBalance).toLocaleString() %>
      <span class="text-base font-medium text-white/60">votes</span>
    </p>
    <a href="/wallet/buy" class="inline-flex items-center gap-2 mt-4 bg-carnival-gold text-carnival-green font-semibold px-5 py-2 rounded-full hover:opacity-90">
      <i class="fa-solid fa-plus"></i> Top Up
    </a>
  </div>

  <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-3">Transaction History</h2>
  <div class="bg-white rounded-2xl shadow divide-y">
    <% transactions.forEach(t => { %>
      <%
        const isCredit = t.type === 'bundle_purchase';
        const icon = t.type === 'bundle_purchase' ? 'fa-coins' : (t.type === 'vote_spend' ? 'fa-check-to-slot' : 'fa-ticket');
      %>
      <a href="/dashboard/wallet/<%= t.id %>" class="p-4 flex items-center gap-3 hover:bg-gray-50">
        <span class="w-10 h-10 rounded-full flex items-center justify-center <%= isCredit ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
          <i class="fa-solid <%= icon %>"></i>
        </span>
        <div class="flex-1 min-w-0">
          <p class="font-semibold capitalize truncate"><%= t.type.replace('_', ' ') %></p>
          <p class="text-xs text-gray-400"><%= new Date(t.createdAt).toLocaleString() %></p>
        </div>
        <div class="text-right">
          <% if (t.amountNaira) { %>
            <p class="font-bold <%= isCredit ? 'text-green-600' : 'text-gray-700' %>"><%= isCredit ? '+' : '' %>₦<%= Number(t.amountNaira).toLocaleString() %></p>
          <% } else if (t.coinAmount) { %>
            <p class="font-bold text-red-500">&minus;<%= Number(t.coinAmount).toLocaleString() %> votes</p>
          <% } %>
          <p class="capitalize text-[10px] font-semibold <%= t.status === 'success' ? 'text-green-600' : (t.status === 'failed' ? 'text-red-600' : 'text-yellow-600') %>"><%= t.status %></p>
        </div>
        <i class="fa-solid fa-chevron-right text-gray-300 text-xs"></i>
      </a>
    <% }) %>
    <% if (!transactions.length) { %><p class="p-4 text-sm text-gray-500">No transactions yet.</p><% } %>
  </div>
</section>
