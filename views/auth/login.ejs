<section class="max-w-md mx-auto px-4 py-16">
  <h1 class="text-2xl font-bold text-carnival-green mb-6 text-center">Log In</h1>
  <form action="/auth/login" method="POST" class="bg-white rounded-2xl shadow p-6 space-y-4">
    <input type="hidden" name="next" value="<%= next %>">
    <div>
      <label class="block text-sm font-medium mb-1">Email</label>
      <input type="email" name="email" required class="w-full border rounded-lg px-3 py-2">
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Password</label>
      <input type="password" name="password" required class="w-full border rounded-lg px-3 py-2">
      <a href="/auth/forgot-password" class="text-xs text-carnival-green hover:underline mt-1 inline-block">Forgot password?</a>
    </div>
    <button class="w-full bg-carnival-green text-white font-semibold py-2 rounded-full hover:opacity-90">Log In</button>
  </form>
  <p class="text-center text-sm text-gray-500 mt-4">
    New here? <a href="/auth/register?next=<%= encodeURIComponent(next) %>" class="text-carnival-green font-semibold hover:underline">Create an account</a>
  </p>
</section>
