<section class="max-w-md mx-auto px-4 py-20 text-center">
  <div class="bg-white rounded-3xl shadow-xl p-8">
    <div class="w-16 h-16 rounded-full bg-carnival-gold/20 text-carnival-gold flex items-center justify-center mx-auto mb-5 text-2xl">
      <i class="fa-solid fa-envelope-circle-check"></i>
    </div>
    <h1 class="text-xl font-bold text-carnival-green mb-2">Verify Your Email</h1>
    <p class="text-sm text-gray-600 mb-6">
      We sent a verification link to <strong><%= currentUser.email %></strong>. Click it to activate
      your account - you'll need to do this before you can vote, buy tickets, or apply as a contestant.
    </p>

    <form action="/auth/resend-verification" method="POST" class="mb-4">
      <button class="w-full bg-carnival-green text-white font-semibold py-3 rounded-full hover:opacity-90">
        Resend Verification Email
      </button>
    </form>

    <p class="text-xs text-gray-400 mb-4">
      Didn't get it? Check your spam folder, or the email service may be temporarily unavailable -
      try resending again in a few minutes.
    </p>

    <form action="/auth/logout" method="POST">
      <button class="text-sm text-gray-500 hover:underline">Log out</button>
    </form>
  </div>
</section>
