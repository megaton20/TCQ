<section class="max-w-md mx-auto px-4 py-16">
  <h1 class="text-2xl font-bold text-carnival-green mb-2 text-center">Forgot Password</h1>
  <p class="text-sm text-gray-500 text-center mb-6">Enter your email and we'll send you a reset link.</p>
  <form action="/auth/forgot-password" method="POST" class="bg-white rounded-2xl shadow p-6 space-y-4">
    <div>
      <label class="block text-sm font-medium mb-1">Email</label>
      <input type="email" name="email" required class="w-full border rounded-lg px-3 py-2">
    </div>
    <button class="w-full bg-carnival-green text-white font-semibold py-2 rounded-full hover:opacity-90">Send Reset Link</button>
  </form>
  <p class="text-center text-sm text-gray-500 mt-4">
    Remembered it? <a href="/auth/login" class="text-carnival-green font-semibold hover:underline">Log in</a>
  </p>
</section>
