{
  "name": "carnival-queen",
  "version": "1.0.0",
  "description": "The Carnival Queen - Pageantry voting, ticketing & contestant management platform",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently \"npm:watch:css\" \"nodemon app.js\"",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --watch",
    "postinstall": "npm run build:css",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "connect-session-sequelize": "^7.1.7",
    "sequelize": "^6.37.3",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "ejs": "^3.1.10",
    "express-ejs-layouts": "^2.5.1",
    "socket.io": "^4.7.5",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^2.4.0",
    "axios": "^1.7.4",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "nanoid": "^3.3.7",
    "connect-flash": "^0.1.1",
    "express-validator": "^7.2.0",
    "moment": "^2.30.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2"
  }
}
